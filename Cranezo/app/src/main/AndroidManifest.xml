<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".app.Cranezo"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cranezo">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".ui.profiletheme.ProfileThemeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cranezo"/>
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Cranezo" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.chooselanguage.ChooseLanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.verifyotp.VerifyOtpActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.chooserole.ChooseRoleActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.cranes.CranesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.booking.BookingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.myprofile.MyProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.mainhome.MainHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
    </application>

</manifest>