<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".app.Cranezo"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cranezo">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Push notifications: receives FCM messages and new tokens -->
        <service
            android:name=".push.CranezoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cranezo_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/push_accent" />

        <activity
            android:name=".ui.profiletheme.ProfileThemeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cranezo"/>
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Cranezo" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.chooselanguage.ChooseLanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.verifyotp.VerifyOtpActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.chooserole.ChooseRoleActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.cranes.CranesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.operator.OperatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.ownerjobs.OwnerJobActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.support.SupportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <!-- Google Maps key comes from local.properties (MAPS_API_KEY) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".ui.preview.FilePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.finance.FinanceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.booking.BookingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.myprofile.MyProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cranezo" />
        <activity
            android:name=".ui.mainhome.MainHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Cranezo" />
    </application>

</manifest>